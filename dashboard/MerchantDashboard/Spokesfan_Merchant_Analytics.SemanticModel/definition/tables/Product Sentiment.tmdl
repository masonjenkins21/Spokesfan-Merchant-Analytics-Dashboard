table 'Product Sentiment'
	lineageTag: 821455f1-7829-43ad-9c59-f14d78f10d8d

	measure 'Negative Sentiment Display' =
			
			FORMAT(
			    AVERAGE('Product Sentiment'[negative_percent])/100,
			    "0.0%"
			)
		lineageTag: a90e0d4a-e155-4f6d-9b8f-4135e34671e8

	measure 'Total Reviews Display' =
			
			FORMAT(
			    SUM('Product Sentiment'[total_reviews]),
			    "#,##0"
			)
		lineageTag: 53703374-df32-43ac-87cb-3d20e268091a

	measure 'Average Rating Display' =
			
			FORMAT(
			    AVERAGE('Product Sentiment'[average_rating]),
			    "0.00"
			)
		lineageTag: 8730a152-0d88-4ab0-b393-c036cddfcfc2

	measure 'Positive Sentiment Display' =
			
			FORMAT(
			    AVERAGE('Product Sentiment'[positive_percent])/100,
			    "0.0%"
			)
		lineageTag: 721e9e40-62f5-4266-a6a3-e96eced27f9e

	measure 'Top Reviewed Product' =
			
			VAR ProductTable =
			    TOPN(
			        1,
			        'Product Sentiment',
			        'Product Sentiment'[total_reviews],
			        DESC
			    )
			RETURN
			    MAXX(
			        ProductTable,
			        'Product Sentiment'[product_name]
			    )
		lineageTag: 2ab599ed-55d5-47f1-ba0f-c17aad677b26

	measure 'Highest Rated Product' =
			
			VAR TopProduct =
			    TOPN(
			        1,
			        FILTER(
			            VALUES('Dim Product Old'[product_name]),
			            CALCULATE(SUM('Product Sentiment'[total_reviews])) > 0
			        ),
			        CALCULATE(MAX('Product Sentiment'[average_rating])), DESC,
			        CALCULATE(SUM('Product Sentiment'[total_reviews])), DESC,
			        'Dim Product Old'[product_name], ASC
			    )
			RETURN
			    CONCATENATEX(
			        TopProduct,
			        'Dim Product Old'[product_name],
			        ", "
			    )
		lineageTag: d4357dfb-4bb9-485c-933b-a8a78847c56d

	measure 'Needs Attention' =
			
			VAR AttentionProduct =
			    TOPN(
			        1,
			        FILTER(
			            VALUES('Dim Product Old'[product_name]),
			            CALCULATE(SUM('Product Sentiment'[total_reviews])) > 0
			        ),
			        CALCULATE(MAX('Product Sentiment'[negative_percent])), DESC,
			        CALCULATE(SUM('Product Sentiment'[total_reviews])), DESC,
			        'Dim Product Old'[product_name], ASC
			    )
			RETURN
			    CONCATENATEX(
			        AttentionProduct,
			        'Dim Product Old'[product_name],
			        ", "
			    )
		lineageTag: a0a8b267-b070-47be-8a40-9cfe8b8ca4c9

	measure 'Product Review Total' =
			
			SUM(
			    'Product Sentiment'[total_reviews]
			)
		formatString: 0
		lineageTag: 51c2a186-c695-49d9-a998-4d54dc684dd9

	measure 'Merchant Total Reviews' =
			
			SUM(
			    'Product Sentiment'[total_reviews]
			)
		formatString: 0
		lineageTag: 97180803-6613-4ebb-af10-c33bd0eadb92

