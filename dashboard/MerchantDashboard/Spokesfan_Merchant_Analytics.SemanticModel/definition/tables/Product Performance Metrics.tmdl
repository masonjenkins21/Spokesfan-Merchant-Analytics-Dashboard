table 'Product Performance Metrics'
	lineageTag: c716d1e4-b5ec-4126-85a4-8bf5ba39afdb

	measure 'Negative Sentiment %' =
			
			DIVIDE(
			    MAX('Product Performance Metrics'[negative_percent]),
			    100
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: de753b98-b792-465a-a0fc-3f06f96bd24b

	measure 'Family Risk Level Background Color' =
			
			VAR RiskLevel =
			    UPPER(
			        TRIM(
			            [Family Risk Level]
			        )
			    )
			RETURN
			    SWITCH(
			        RiskLevel,
			        "HIGH", "#F8E4E4",
			        "MEDIUM", "#FBF0DD",
			        "LOW", "#E5F1EA",
			        "NOT ASSESSED", "#ECECEC",
			        "#FFFFFF"
			    )
		lineageTag: a7329bef-ab1a-4269-bb12-91d1b07cc3a9

	measure 'Family Risk Level Font Color' =
			
			VAR RiskLevel =
			    UPPER(
			        TRIM(
			            [Family Risk Level]
			        )
			    )
			RETURN
			    SWITCH(
			        RiskLevel,
			        "HIGH", "#A63D3D",
			        "MEDIUM", "#A36C18",
			        "LOW", "#3F775B",
			        "NOT ASSESSED", "#666666",
			        "#252525"
			    )
		lineageTag: e2d4361b-9e8a-457f-8290-bde0e27f0262

	measure 'Risk Level Background Color' =
			
			VAR RiskLevel =
			    UPPER(
			        TRIM(
			            SELECTEDVALUE(
			                'Product Performance Metrics'[risk_level]
			            )
			        )
			    )
			RETURN
			    SWITCH(
			        RiskLevel,
			        "HIGH", "#F8E4E4",
			        "MEDIUM", "#FBF0DD",
			        "LOW", "#E5F1EA",
			        "NOT ASSESSED", "#ECECEC",
			        "#FFFFFF"
			    )
		lineageTag: 6cf801e5-8ca8-4bf4-922a-2c6ae32cf10f

	measure 'Risk Level Font Color' =
			
			VAR RiskLevel =
			    UPPER(
			        TRIM(
			            SELECTEDVALUE(
			                'Product Performance Metrics'[risk_level]
			            )
			        )
