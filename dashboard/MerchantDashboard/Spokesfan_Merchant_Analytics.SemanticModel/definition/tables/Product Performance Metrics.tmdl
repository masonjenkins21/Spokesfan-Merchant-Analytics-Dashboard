	partition 'Product Performance Metrics' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\mason\PycharmProjects\SpokesfanMerchantAnalytics\data\processed\dashboard_metrics\product_risk_analysis.csv"),[Delimiter=",", Columns=13, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"merchant", type text}, {"product_name", type text}, {"total_reviews", Int64.Type}, {"negative_reviews", Int64.Type}, {"average_rating", type number}, {"low_rating_reviews", Int64.Type}, {"average_confidence", type number}, {"negative_percent", type number}, {"low_rating_percent", type number}, {"review_volume_score", type number}, {"review_confidence", type number}, {"risk_score", type number}, {"risk_category", type text}}),
				    #"Trimmed Text" = Table.TransformColumns(#"Changed Type",{{"product_name", Text.Trim, type text}, {"merchant", Text.Trim, type text}}),
				    #"Cleaned Text" = Table.TransformColumns(#"Trimmed Text",{{"product_name", Text.Clean, type text}, {"merchant", Text.Clean, type text}}),
				    #"Merged Queries" = Table.NestedJoin(#"Cleaned Text", {"merchant", "product_name"}, #"Product Risk Summary", {"merchant", "product_name"}, "Product Risk Summary", JoinKind.LeftOuter),
				    #"Added Custom" = Table.AddColumn(#"Merged Queries", "Match Status", each if Table.RowCount([Product Risk Summary]) > 0 then "Matched" else "Unmatched"),
				    #"Filtered Rows" = Table.SelectRows(#"Added Custom", each true),
				    #"Expanded Product Risk Summary" = Table.ExpandTableColumn(#"Filtered Rows", "Product Risk Summary", {"priority_rank", "risk_level", "product_risk_score", "primary_customer_concern"}, {"priority_rank", "risk_level", "product_risk_score", "primary_customer_concern"}),
				    #"Added Custom1" = Table.AddColumn(#"Expanded Product Risk Summary", "display_risk_level", each if [risk_level] = null
				then "Not Assessed"
				else [risk_level]),
				    #"Removed Columns" = Table.RemoveColumns(#"Added Custom1",{"risk_level"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Columns",{{"display_risk_level", "risk_level"}}),
				    #"Removed Columns1" = Table.RemoveColumns(#"Renamed Columns",{"Match Status", "risk_category"}),
				    #"Added Custom2" = Table.AddColumn(#"Removed Columns1", "risk_sort", each if [risk_level] = "High" then 1
				else if [risk_level] = "Medium" then 2
				else if [risk_level] = "Low" then 3
				else 4),
				    #"Added Custom3" = Table.AddColumn(#"Added Custom2", "Product Family", each if Text.Contains([product_name], "Bright Side", Comparer.OrdinalIgnoreCase)
				    or Text.Contains([product_name], "Bright Tight", Comparer.OrdinalIgnoreCase)
				    or Text.Contains([product_name], "Brighten Hydrate", Comparer.OrdinalIgnoreCase)
				    or Text.Contains([product_name], "Brighter Days", Comparer.OrdinalIgnoreCase)
				then "Brightening Eye Collection"
				
				else if Text.Contains([product_name], "Firm Believer", Comparer.OrdinalIgnoreCase)
				    or Text.Contains([product_name], "Firming Day Night Duo", Comparer.OrdinalIgnoreCase)
				then "Firming Collection"
				
				else if Text.Contains([product_name], "Dream Bio Retinol", Comparer.OrdinalIgnoreCase)
				    or Text.Contains([product_name], "Natural Icons", Comparer.OrdinalIgnoreCase)
				    or Text.Contains([product_name], "Skin Hero", Comparer.OrdinalIgnoreCase)
				then "Bio-Retinol Collection"
				
				else if Text.Contains([product_name], "Best Sellers Discovery", Comparer.OrdinalIgnoreCase)
				    or Text.Contains([product_name], "Best Sellers Trial", Comparer.OrdinalIgnoreCase)
				then "Best Sellers Kits"
				
				else [product_name]),
				    #"Trimmed Text1" = Table.TransformColumns(#"Added Custom3",{{"merchant", Text.Trim, type text}, {"product_name", Text.Trim, type text}}),
				    #"Cleaned Text1" = Table.TransformColumns(#"Trimmed Text1",{{"merchant", Text.Clean, type text}, {"product_name", Text.Clean, type text}}),
				    #"Added Custom4" = Table.AddColumn(#"Cleaned Text1", "product_key", each Text.Lower(Text.Trim([merchant]))
				    & "|"
				    & Text.Lower(Text.Trim([product_name])))
				in
				    #"Added Custom4"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

