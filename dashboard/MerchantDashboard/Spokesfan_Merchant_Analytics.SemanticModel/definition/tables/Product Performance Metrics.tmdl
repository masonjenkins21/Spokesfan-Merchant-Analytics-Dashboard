			RETURN
			    SWITCH(
			        RiskLevel,
			        "HIGH", "#A63D3D",
			        "MEDIUM", "#A36C18",
			        "LOW", "#3F775B",
			        "NOT ASSESSED", "#666666",
			        "#252525"
			    )
		lineageTag: dbccd136-ee88-449d-a3de-7ee9fb772236

